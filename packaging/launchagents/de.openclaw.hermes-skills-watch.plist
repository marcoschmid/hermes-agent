<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>de.openclaw.hermes-skills-watch</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/marco/Code/hermes-agent</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/marco/Code/hermes-agent/.venv/bin/python</string>
      <string>/Users/marco/Code/hermes-agent/tools/workspace_skills_watch.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PYTHONPATH</key>
      <string>/Users/marco/Code/hermes-agent</string>
      <key>HERMES_WORKSPACE_SKILLS</key>
      <string>/Users/marco/.openclaw/workspace/skills</string>
      <key>HERMES_HOME</key>
      <string>/Users/marco/.hermes</string>
      <key>PYTHONUNBUFFERED</key>
      <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/marco/.openclaw/logs/hermes-skills-watch.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/marco/.openclaw/logs/hermes-skills-watch.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
  </dict>
</plist>
